# The Siavonga Independence Run 2026 backend (siavonga-independence-api).
# Local dev default matches `docker compose up` in that repo (port 8001 —
# chosen to avoid clashing with other local Django projects on 8000; see
# that repo's docker-compose.yml). Set to the real deployed address in
# production.
VITE_API_BASE_URL=http://localhost:8001
